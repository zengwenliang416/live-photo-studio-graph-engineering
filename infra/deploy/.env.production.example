APP_IMAGE=live-photo-studio:replace-with-commit
POSTGRES_DB=live_photo_studio
POSTGRES_USER=live_photo_studio
POSTGRES_PASSWORD=replace-with-random-hex
REDIS_PASSWORD=replace-with-random-hex
DATABASE_URL=postgresql://live_photo_studio:replace-with-random-hex@postgres:5432/live_photo_studio
REDIS_URL=redis://:replace-with-random-hex@redis:6379

PORT=4000
API_BIND_PORT=4040
WEB_BIND_PORT=3030
PUBLIC_URL=https://livephoto.motion-cover.com
AUTH_SESSION_TTL_SECONDS=604800
AUTH_MAX_SESSIONS_PER_USER=10
AUTH_COOKIE_SECURE=true
AUTH_ALLOWED_ORIGINS=https://livephoto.motion-cover.com
GRAPH_COMMAND_QUEUE=graph-commands
GRAPH_SIGNAL_QUEUE=graph-signals
GENERATION_JOB_QUEUE=generation-jobs
RENDER_JOB_QUEUE=render-jobs
ASSET_PREVIEW_JOB_QUEUE=asset-preview-jobs
ORCHESTRATOR_CONCURRENCY=2
AI_WORKER_CONCURRENCY=1
MEDIA_WORKER_CONCURRENCY=1
ASSET_PREVIEW_WORKER_CONCURRENCY=1
GRAPH_CHECKPOINT_SETUP=false
GRAPH_MAX_REPAIR_ATTEMPTS=2
GRAPH_SIGNAL_VISIBILITY_TIMEOUT_MS=60000
GRAPH_SIGNAL_RECOVERY_INTERVAL_MS=30000
GRAPH_WORKFLOW_ENABLED=true
# Leave empty to enable Graph workflow for every authenticated user.
GRAPH_WORKFLOW_CANARY_USER_IDS=
# Set to comma-separated authenticated user UUIDs for operator endpoints.
GRAPH_ADMIN_USER_IDS=
SETTINGS_ENCRYPTION_KEY=replace-with-64-hex-characters

OBJECT_STORAGE_BACKEND=s3
OBJECT_STORAGE_ENDPOINT=https://storage.motion-cover.com
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=camera-rental-return
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-server-side-key
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-server-side-secret
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=300

AI_PROVIDER=mock
AI_MAX_COST_MICROS=0
OPENAI_IMAGE_MODEL=gpt-image-2
UPLOAD_MAX_BYTES=20971520
EXPORT_DURATION_MS=1500
