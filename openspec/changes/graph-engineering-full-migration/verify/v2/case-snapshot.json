          ]
        },
        {
          "id": "step-storage-cors",
          "action": "Run a RustFS preflight with Origin set to the public canary URL.",
          "expected": "Access-Control-Allow-Origin exactly equals https://livephoto.motion-cover.com and unsigned object access remains denied.",
          "assertion_ids": [
            "assert-storage-cors-private"
          ]
        },
        {
          "id": "step-secret-review",
          "action": "Inspect Compose, CI logs, browser responses and captured evidence for secret material.",
          "expected": "No Basic Auth password, storage credential, encryption key, signed URL or full prompt is present.",
