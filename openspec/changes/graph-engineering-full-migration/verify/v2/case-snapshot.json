      "change_id": "graph-engineering-full-migration",
      "requirement_ids": [
        "REQ-5"
      ],
      "acceptance_ids": [
        "A3"
      ],
      "title": "Validate protected ingress and private storage boundary",
      "goal": "Prove unauthenticated access is rejected, authenticated Web and API succeed, and RustFS permits only the exact canary origin.",
      "actor": "canary-operator",
      "priority": "P0",
      "preconditions": [
        "Cloudflare DNS is proxied to the designated server.",
        "Nginx loads Basic Auth from an operator-only file.",
        "The RustFS bucket remains private."
      ],
      "steps": [
        {
          "id": "step-ingress-unauthorized",
          "action": "Request the public canary without Basic Auth.",
          "expected": "The request returns HTTP 401.",
          "assertion_ids": [
            "assert-ingress-401"
          ]
        },
        {
          "id": "step-ingress-authorized",
          "action": "Request the Web and same-origin API with the approved Basic Auth credentials.",
          "expected": "The Web project route and /v1/stream-health return HTTP 200.",
          "assertion_ids": [
