

# Graph Engineering runtime
GRAPH_COMMAND_QUEUE=graph-commands
GRAPH_SIGNAL_QUEUE=graph-signals
ASSET_PREVIEW_JOB_QUEUE=asset-preview-jobs
ASSET_PREVIEW_WORKER_CONCURRENCY=1
ORCHESTRATOR_CONCURRENCY=4
# Run checkpoint schema setup only as an explicit deployment/migration action.
GRAPH_CHECKPOINT_SETUP=false
GRAPH_MAX_REPAIR_ATTEMPTS=2

# Local infrastructure
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/live_photo_studio
REDIS_URL=redis://localhost:6379
API_PORT=4000

# Application authentication
AUTH_SESSION_TTL_SECONDS=604800
AUTH_MAX_SESSIONS_PER_USER=10
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Object storage
# Keep the mock backend for ordinary local development and CI. For a
# server-side RustFS deployment, inject the following values into API and
# Media Worker only; never expose the credentials through NEXT_PUBLIC_*.
OBJECT_STORAGE_BACKEND=mock
# OBJECT_STORAGE_ENDPOINT=https://storage.motion-cover.com
# OBJECT_STORAGE_REGION=us-east-1
# OBJECT_STORAGE_BUCKET=live-photo-studio
# OBJECT_STORAGE_ACCESS_KEY_ID=<server-side-access-key>
# OBJECT_STORAGE_SECRET_ACCESS_KEY=<server-side-secret-key>
# OBJECT_STORAGE_FORCE_PATH_STYLE=true
# OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=300
FFMPEG_PATH=ffmpeg

# Per-user image provider settings encryption (AES-256-GCM, 32-byte hex).
# Generate with: openssl rand -hex 32
# SETTINGS_ENCRYPTION_KEY=

# Server-side fallback image provider (used when a user has no saved setting).
# Priority: user setting > these env values > mock provider.
# OPENAI_COMPAT_BASE_URL=
# OPENAI_COMPAT_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2

# Upload guardrails
# Maximum accepted original-photo size in bytes (default 20 MiB).
UPLOAD_MAX_BYTES=20971520

# Web frontend
NEXT_PUBLIC_API_BASE=http://localhost:4000
NEXT_PUBLIC_GRAPH_WORKFLOW_ENABLED=true
